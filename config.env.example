# Konfigurácia agenta kúrenia (/opt/kurenie/config.env)
# Po zmene:  systemctl restart kurenie-agent kurenie-web

# Kľúč z https://openrouter.ai/keys  (vlož za znak =, bez úvodzoviek)
OPENROUTER_API_KEY=

# Model na OpenRouter (lacný: anthropic/claude-haiku-5.5, google/gemini-2.5-flash-lite)
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Záložný model: použije sa raz, keď hlavný model zlyhá (chyba servera 5xx/429, timeout, nevalidný JSON).
# Prázdne = záložný model vypnutý. Chyba kľúča/kreditu (401/402) sa neopakuje.
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash-lite

# Adresa ESP modulu m5stack-tc
ESP_URL=http://192.168.1.199

# Približná poloha pre predpoveď počasia (open-meteo.com, zaokrúhlené na 0,1°). Prázdne = bez predpovede.
LAT=48.1
LON=17.1

# Ako často agent beží (minúty)
INTERVAL_MIN=60

# Najdlhšia pauza medzi volaniami modelu (hodiny, 1-12). Medzitým agent beží "rutinne" bez modelu
# a model zavolá skôr len vtedy, keď sa niečo zmení (správa, zásah, odchýlka teploty, chyba...).
LLM_MAX_GAP_H=4

# Upozornenia: adresa webhooku Home Assistant (POST JSON {"title","message","kind"}). Prázdne = upozornenia vypnuté.
# Napr. http://homeassistant.local:8123/api/webhook/<tajne-id>
NOTIFY_URL=

# Home Assistant: odtiaľ agent číta okenné a dverné kontakty (len čítanie, nič sa do HA nezapisuje).
# Adresa HA (z LXC sa prekladá na LAN adresu). Token sa zadáva na webe v Nastaveniach -> Home Assistant;
# tu ho netreba písať ručne. Vytvoríš ho v HA: profil -> Zabezpečenie -> Dlhodobé prístupové tokeny.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Čistenie databázy (backup.sh): minútové vzorky v tc.db staršie ako tento počet dní sa zredukujú na 5-minútový raster.
RETENTION_FULL_DAYS=60

# Štatistiky: samostatná SQLite databáza (trvalé hodinové dáta, nikdy sa nečistí). Prázdne = ROOT/stats.db.
STATS_DB=

# Štatistiky: základ pre stupňo-dni (HDD) = teplota, pod ktorou sa dom kúri (10 až 25 °C), predvolene 18.
STATS_HDD_BASE=18

# Skúšobný režim: 1 = do ESP ani na webhook sa nič neodosiela (len záznam v logu). Na ostrú prevádzku nechaj 0.
DRY_RUN=0

WEB_PORT=80